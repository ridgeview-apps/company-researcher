# Application
APP_NAME="Company Researcher"
APP_ENVIRONMENT=local
ARTIFACT_ROOT=data/artifacts

# Origins allowed to call the API from a browser (the web/ dev server's
# default Vite port). JSON array syntax, as pydantic-settings expects for a
# list field.
# CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# PostgreSQL container
POSTGRES_DB=company_researcher
POSTGRES_USER=company_researcher
POSTGRES_PASSWORD=company_researcher
POSTGRES_PORT=5432
API_PORT=8000

# Application database connection (API running directly on the host)
DATABASE_URL=postgresql+asyncpg://company_researcher:company_researcher@localhost:5432/company_researcher

# Obtain a key from the Companies House developer portal.
COMPANIES_HOUSE_API_KEY=replace-with-your-api-key
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_DOCUMENT_BASE_URL=https://document-api.company-information.service.gov.uk

# Obtain a key from the OpenAI platform dashboard.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: trace investigation-agent runs to LangSmith. Off by default; only
# needed if you want to inspect a real run's node/LLM-call waterfall.
# Obtain a key from https://smith.langchain.com. If your account is on
# LangSmith's EU region (its web UI is at eu.smith.langchain.com), also set
# LANGSMITH_ENDPOINT below - otherwise API calls fail with 403 Forbidden.
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=replace-with-your-api-key
LANGSMITH_PROJECT=company-researcher
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
